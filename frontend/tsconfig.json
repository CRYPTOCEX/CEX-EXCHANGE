{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "preserveWatchOutput": true,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/ui/chart": [
        "./components/ui/chart/index.ts"
      ],
      "@/lib/stubs/chart-engine-stub": [
        "./components/(ext)/chart-engine/dist/index.d.ts",
        "./lib/stubs/chart-engine-stub.ts"
      ],
      "next-intl": [
        "./i18n/next-intl-compat"
      ],
      "next-intl/server": [
        "./i18n/next-intl-compat/server"
      ],
      "@/app/[locale]/(ext)/admin/ai/binary-engine/menu": [
        "./app/[locale]/(ext)/admin/ai/binary-engine/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/ai/support/inbox/case-pane": [
        "./app/[locale]/(ext)/admin/ai/support/inbox/case-pane",
        "./lib/stubs/ext-case-pane-stub.tsx"
      ],
      "@/app/[locale]/(ext)/admin/ai/support/menu": [
        "./app/[locale]/(ext)/admin/ai/support/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/dex/menu": [
        "./app/[locale]/(ext)/admin/dex/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/forex-trading/account/columns": [
        "./app/[locale]/(ext)/admin/forex-trading/account/columns",
        "./lib/stubs/ext-columns-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/forex-trading/deal/columns": [
        "./app/[locale]/(ext)/admin/forex-trading/deal/columns",
        "./lib/stubs/ext-columns-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/forex-trading/menu": [
        "./app/[locale]/(ext)/admin/forex-trading/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/forex-trading/position/columns": [
        "./app/[locale]/(ext)/admin/forex-trading/position/columns",
        "./lib/stubs/ext-columns-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/hb/menu": [
        "./app/[locale]/(ext)/admin/hb/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/trading-bot/bot/columns": [
        "./app/[locale]/(ext)/admin/trading-bot/bot/columns",
        "./lib/stubs/ext-columns-stub.ts"
      ],
      "@/app/[locale]/(ext)/admin/trading-bot/menu": [
        "./app/[locale]/(ext)/admin/trading-bot/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/dex/menu": [
        "./app/[locale]/(ext)/dex/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/forex-trading/menu": [
        "./app/[locale]/(ext)/forex-trading/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/hb/menu": [
        "./app/[locale]/(ext)/hb/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ],
      "@/app/[locale]/(ext)/trading-bot/menu": [
        "./app/[locale]/(ext)/trading-bot/menu",
        "./lib/stubs/ext-menu-stub.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "lib/**/*.js",
    "components/**/*.jsx",
    "components/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "app/**/*.tsx",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "../backend/**/*",
    "../node_modules/**/*",
    "dist",
    ".next"
  ]
}
