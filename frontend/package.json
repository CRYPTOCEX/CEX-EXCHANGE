  "scripts": {
    "dev": "node ../scripts/clean-stale-files.mjs && next dev -H 0.0.0.0",
    "dev:turbo": "node ../scripts/clean-stale-files.mjs && next dev --turbopack -H 0.0.0.0",
    "build": "node ../scripts/check-build-memory.mjs && node ../scripts/clean-stale-files.mjs && cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:i18n": "node i18n/scripts/generate-i18n-manifest.js",
    "build:full": "npm run build:i18n && npm run build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "build:chart-engine": "npm --prefix \"components/(ext)/chart-engine\" install --no-audit --no-fund && npm --prefix \"components/(ext)/chart-engine\" run build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit",
    "design:debt": "node scripts/scan-design-debt.js --top 20",
    "design:baseline": "node scripts/scan-design-debt.js --baseline",
    "design:check": "node scripts/design-check.mjs",
    "design:list": "node scripts/scan-design-debt.js --list",
