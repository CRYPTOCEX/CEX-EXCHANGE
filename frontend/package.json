    "design:budget": "node scripts/scan-design-debt.js --budget",
    "design:tokens": "node scripts/gen-design-defaults.js",
    "fonts:vendor": "node scripts/vendor-fonts.mjs",
    "design:components": "node scripts/verify-component-tokens.js",
    "design:status": "node scripts/audit-status-variants.js",
    "check:client-boundary": "node scripts/check-client-boundary.js",
    "check:permission": "node ../tools/build-permission.js --check",
    "skeleton:debt": "node scripts/scan-skeleton-debt.js --top 25",
    "skeleton:baseline": "node scripts/scan-skeleton-debt.js --baseline",
    "skeleton:check": "node scripts/scan-skeleton-debt.js --check",
    "skeleton:cls": "node scripts/measure-layout-shift.mjs",
    "skeleton:auth": "node scripts/auth-storage-state.mjs"
