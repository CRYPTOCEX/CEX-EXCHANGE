# --------------- Rate Limit ---------------
RATE_LIMIT="100" # per-IP cap on MUTATING requests (POST/PUT/PATCH/DELETE) per window. GETs are not counted.
RATE_LIMIT_EXPIRE="60" # window length in seconds. Read as RATE_LIMIT_EXPIRY too, for installs that already set the old name.
HB_RATE_LIMIT="1200" # per-IP cap on MUTATING requests to the SIGNED Hummingbot bot endpoints (/api/hb/* minus the browser surfaces), applied only when a full HMAC header set is present. Bot traffic is additionally capped per API key by the addon Trade/Read/Account budgets, so this is a floor, not the governing limit. Must be >= the Trade budget (default 600) or that budget cannot be delivered.
HB_AUTH_FAIL_LIMIT="30" # failed HMAC verifications one IP may accumulate per minute before the bot-sized waiver above is withdrawn and it drops back to RATE_LIMIT.


# If using a browser like your Nuxt app, use 'browser' for production
# If using a browser like your Nuxt app, use 'browser-dev' for development
# If you're not using a browser, then use 'app'
