# --------------- App ---------------

NEXT_PUBLIC_SITE_URL="http://localhost"
NEXT_PUBLIC_SITE_NAME="Bicrypto"
NEXT_PUBLIC_SITE_DESCRIPTION="Bicrypto is a cryptocurrency exchange platform, where you can trade Bitcoin, Ethereum, Litecoin, and other cryptocurrencies."
# DEMO SITES ONLY. When "true", EVERY new registration is given the Admin role
# (both email/password and Google signup) so visitors can browse the admin panel.
# This applies on production builds too. Leave it "false" on any real deployment.
NEXT_PUBLIC_DEMO_STATUS="false"
NODE_ENV="production"
NEXT_PUBLIC_FRONTEND_PORT="3000"
NEXT_PUBLIC_BACKEND_PORT="4000"
NEXT_PUBLIC_BACKEND_THREADS="2"
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_LANGUAGES="en,es,fr,de,it,pt,ru,ar,ja,ko,hi,tr"
NEXT_PUBLIC_DEFAULT_THEME="dark" # dark, light, system
NEXT_PUBLIC_FRONTEND="true" # true, false

# Development only: Additional allowed IPs for dev server (comma-separated)
# These are used for accessing the dev server from local network devices
# Example: "192.168.0.251,172.28.112.1,172.23.144.1"
NEXT_PUBLIC_ALLOWED_DEV_IPS=""

# SET THIS TO "true" IF ANYTHING SITS IN FRONT OF THE BACKEND — nginx, Apache,
# Caddy, Cloudflare, a load balancer. Almost every real deployment does.
#
# WHAT GOES WRONG WHEN IT IS MISSING. Behind a proxy the TCP peer the backend
# sees is the PROXY (127.0.0.1), not the visitor. Every per-IP control on the
# platform then meters the whole internet into ONE bucket:
#
#   * signup        3 accounts / hour  -> 3 for the ENTIRE SITE, fail-closed.
#                   Everyone else is told "Too many accounts have been created
#                   from this address", whatever address they are actually on.
#   * loginAttempt  30 sign-ins / 15 min for the entire site.
#   * strict        5 / 15 min, shared, on wallet login and password reset.
#   * geo-restriction rules geolocate the proxy rather than the visitor.
#
# LEAVE THIS UNSET unless a proxy sits on a DIFFERENT host from the backend.
# Unset, the backend works it out for itself: it honours forwarding headers only
# when the connection actually arrived from a loopback or private address — i.e.
# from a proxy on this machine — and ignores them for anything that reached the
# API port straight off the internet. That is the correct answer for a normal
# Apache or nginx install with no configuration at all.
#
#   TRUST_PROXY="true"   honour the headers even from a PUBLIC peer. Needed only
#                        for a load balancer on a separate host (AWS ALB, GCP LB).
#                        DANGEROUS if the API port is reachable from the internet:
#                        anyone hitting it directly then picks their own address.
#   TRUST_PROXY="false"  never honour them. Every visitor is metered as the
#                        proxy, so the whole site shares one rate-limit bucket
#                        and geo rules geolocate the proxy. Diagnostics only.
#
# STRIP THE CLIENT'S COPY AT THE PROXY ANYWAY. Apache's mod_proxy and nginx's
# $proxy_add_x_forwarded_for both APPEND to whatever the client sent, so a
# request with a forged header arrives as "<forged>, <real>". The backend reads
# the list from the RIGHT precisely so the forged part is ignored — but one
# correct line at the proxy removes the ambiguity entirely:
#
#   Apache:  a2enmod headers
#            RequestHeader unset X-Forwarded-For     (before ProxyPass)
#            ProxyPass /api http://127.0.0.1:4000/api    (127.0.0.1, not localhost)
#   nginx:   proxy_set_header X-Forwarded-For $remote_addr;
#            (NOT $proxy_add_x_forwarded_for — that one appends)

# Networks OTHER than loopback whose requests may carry a forwarding header.
# Comma-separated addresses or CIDRs. Leave empty unless a proxy of yours is on
# a different machine — loopback is trusted with no configuration.
#
#   TRUST_PROXY_CIDRS="10.0.0.0/8"          proxy elsewhere on a private network
#   TRUST_PROXY_CIDRS="173.245.48.0/20,..." Cloudflare's published ranges
#
# Setting this ALSO unlocks the single-value CDN headers (CF-Connecting-IP,
# True-Client-IP, X-Real-IP). They are ignored by default and that is deliberate:
# Apache and nginx pass client headers straight through, so on an install with no
# CDN in front, a caller can simply send `CF-Connecting-IP: 1.2.3.4` and be
# believed. Declaring your upstream networks is the assertion that a CDN is
# really there.
#
# For Cloudflare the cleaner option is to let nginx do it — `set_real_ip_from`
# plus `real_ip_header CF-Connecting-IP` rewrites $remote_addr, and the
# `$remote_addr` line above then carries the true visitor with nothing set here.
TRUST_PROXY_CIDRS=""

# Next.js Server Actions are NOT used by this app; requests trying to invoke one
# (exploit-scanner probes, stale browser tabs from old builds) are rejected by
# frontend/middlewares/serverActionGuard.ts. Only if server actions are ever
# added to the frontend: set ENABLE_SERVER_ACTIONS="true" to disable that guard
# (runtime flag — restarting the frontend process is enough, no rebuild), and pin
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY to a fixed base64 AES key (16/24/32 bytes,
# build-time) so action IDs survive rebuilds/updates across instances.
# See https://nextjs.org/docs/messages/failed-to-find-server-action
# ENABLE_SERVER_ACTIONS="true"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --------------- Database ---------------

DB_NAME="v4"
DB_USER="root"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="3306"

# --------------- ScyllaDB (market data) ---------------
#
# Order books, candles, trades and futures positions live in Scylla, not MySQL.
# Every key below has a working default, which is why none of them had to be
# written down before — but that also meant there was no way to discover them.
#
# INSTALLS THAT DO NOT USE THE ECOSYSTEM OR FUTURES EXTENSIONS can ignore this
# whole block; nothing reads Scylla until one of those is enabled.

# The kill switch. Default ON.
#
# CAREFUL: only the literal string "false" turns it off. `SCYLLA_ENABLED="0"`,
# `"no"` and `"off"` all leave it ENABLED — the code reads
# `(value || "true").toLowerCase() !== "false"`.
SCYLLA_ENABLED="true"

# Contact points, comma separated, `host:port`.
SCYLLA_CONNECT_POINTS="127.0.0.1:9042"

# Keyspaces. Two of them: spot/ecosystem and futures are separate.
SCYLLA_KEYSPACE="trading"
SCYLLA_FUTURES_KEYSPACE="futures"

# Authentication. Leave both empty for a cluster with authentication disabled,
# which is the default for a local single-node install.
SCYLLA_USERNAME=""
SCYLLA_PASSWORD=""

# The local datacenter name, as the cluster reports it. A single-node install
# created with the stock configuration calls itself `datacenter1`; if you
# renamed it, this must match or the driver treats every node as remote.
SCYLLA_DATACENTER="datacenter1"

# Connections per host, 1-32. Anything outside that range, or a fractional
# value, falls back to 4.
SCYLLA_LOCAL_CONNECTIONS="4"

# --------------- Config ---------------

# How much the backend prints. Read once at start-up; changing it needs a
# restart.
#
#   debug   everything, including per-step task output
#   info    the default, and what you want in production
#   warn    warnings and errors only
#   error   errors only
#   silent  NOTHING — and that includes errors. The filter is ">=", and
#           `silent` outranks `error`, so this is a true off switch, not
#           "quiet". Do not set it on a server you expect to diagnose.
#
# An unrecognised value falls back to `info` without complaining.
LOG_LEVEL="info"

# ANSI COLOUR — the standard cross-tool variables, not set here on purpose.
#
#   NO_COLOR      set to ANY non-empty value to disable colour
#   FORCE_COLOR   set to ANY non-empty value to force it on
#
# READ THAT AGAIN: any non-empty value. These are read by plain truthiness, so
#   NO_COLOR="false"   disables colour
#   NO_COLOR="0"       disables colour
#   NO_COLOR=""        does nothing (this is the "off" you want)
#
# which is why they are documented here rather than written as settings — an
# entry in this file is an invitation to put "false" in it. To disable colour,
# export the variable in the environment; to keep it, leave both unset.
# NO_COLOR=""
# FORCE_COLOR=""

NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# --------------- Wallet connections (Reown / WalletConnect) ---------------

# The Reown (formerly WalletConnect) project id. Free: https://cloud.reown.com
# Create a project of type "App" with your site's URL, copy its Project ID, and
# restrict it to your domain — the id is visible to anyone who loads your site.
#
# It powers every screen that talks to a browser or mobile wallet: signing in
# with a wallet, "Profile → Wallet" linking, the NFT wallet actions and the
# Swap terminal. Leave it empty and those screens show "Wallet connection is
# not set up yet" instead of a connect button; nothing else is affected.
#
# NEXT_PUBLIC_: the value is COMPILED INTO THE FRONTEND BUNDLE. Setting or
# changing it needs a frontend rebuild — `pnpm build:frontend` or
# `pnpm updator` — a restart is not enough. The backend reads the same
# variable at start-up to verify wallet signatures, so restart it as well.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=""

