# Fiat rate providers, comma-separated in PRIORITY order. All of them are queried
# every run and the results are merged, so coverage is the UNION — a currency one
# source is missing is still priced by another. For a currency several sources
# carry, the earliest listed one wins, and any cross-source disagreement above 2%
# is logged (redenominated codes like ZWL/SYP/SSP routinely disagree wildly).
#
# Available:
#   openexchangerates  ~172 currencies  needs APP_OPENEXCHANGERATES_APP_ID
#   exchangerate-api   ~166 currencies  needs APP_EXCHANGERATE_API_KEY
#   open-er-api        ~166 currencies  keyless (same upstream as exchangerate-api)
#   currency-api       ~338 currencies  keyless
#   frankfurter         ~30 currencies  keyless, ECB reference rates
#
# Providers whose key is absent are skipped automatically, so the keyless ones
# alone still cover ~159/160 currencies. Leave unset to use all of the above.
APP_FIAT_RATES_PROVIDERS=""

# How a currency carried by several sources is resolved.
#   consensus (default) — when independent sources cluster on a value, the largest
#                         cluster wins and a lone dissenter is outvoted. Guards
#                         against a stale primary: OpenExchangeRates was observed
#                         serving SSP at 130 while three other sources agreed on
#                         ~4900, SCR at 13.55 vs ~14.51, SLL at 20969 vs ~24364.
#   priority            — always take the earliest-listed provider that has it.
# Either way, disagreement above 2% is logged with every source's value.
APP_FIAT_RATES_MERGE="consensus"

# Deprecated: single-provider selection. Still honoured — it pins that provider to
# the FRONT of the priority list rather than disabling the others. Prefer
# APP_FIAT_RATES_PROVIDERS above.
APP_FIAT_RATES_PROVIDER="openexchangerates"

# OpenExchangeRates API
APP_OPENEXCHANGERATES_APP_ID="xxxxxxxxxxxxxxxxxxxx"

# ExchangeRate API
APP_EXCHANGERATE_API_KEY="xxxxxxxxxxxxxxxxxxxx"

# --------------- Explorer / transaction-history providers ---------------
#
# EVM transaction history and native-deposit detection are served by a chain of
# explorer providers tried in a PER-CHAIN order with automatic failover. Two of
# them — Blockscout and Routescan — need no credential at all and are appended
# to every chain's order as a last resort, so an install with none of the keys
# below still resolves history on ETH, ARBITRUM, OPTIMISM, BASE, CELO and RSK
# (both networks of each) and on POLYGON mainnet only (137 — there is no
# instance for Amoy 80002). AVALANCHE (43114/43113) is keyless too, served by
# Routescan rather than Blockscout, and Blockscout also has mapped instances for
# Gnosis (100), zkSync (324) and Scroll (534352).
#
# Etherscan's FREE tier no longer covers BSC (56/97), OP Mainnet (10/11155420),
# Base (8453/84532) or Avalanche (43114), and Gnosis (100) moves to paid on
# 2026-09-01. The built-in order already leads those chains with a provider that
# is actually free for them, so leaving everything below blank is a valid setup.
#
# Five chains have NO keyless option — no hosted Blockscout instance and no
# Routescan coverage: BSC (56/97), Fantom (250/4002), Cronos (25), HECO
# (128/256) and Polygon's Amoy testnet (80002). BSC is special only in that a
# keyed provider is the normal answer there for a production install: NodeReal
# is free for BSC mainnet (56), and on testnet (97) only Moralis and Covalent
# index it — Ankr and NodeReal do not. So set NODEREAL_API_KEY for 56, or
# MORALIS_API_KEY / COVALENT_API_KEY for 97.
#
# EVERY key below may hold a LIST (comma-separated). The dispatcher rotates
# through it on auth / plan / rate-limit failures before giving up on the
# provider. Each can also be scoped to one chain by prefixing the chain symbol —
# BSC_NODEREAL_API_KEY, POLYGON_COVALENT_API_KEY — and the chain-scoped list is
# tried first with the global one standing behind it as a spare.

# Etherscan API V2 multichain key. Per-chain override: {CHAIN}_EXPLORER_API_KEY
# or {CHAIN}_ETHERSCAN_API_KEY. NOT inherited by custom EVM chains.
ETHERSCAN_API_KEY=

# Keyed fallbacks. Ankr covers the most mainnets, Moralis and Covalent are the
# two that index BSC testnet, NodeReal covers ETH and BSC mainnet only.
ANKR_API_KEY=
MORALIS_API_KEY=
COVALENT_API_KEY=
NODEREAL_API_KEY=

# OPTIONAL. Blockscout and Routescan work with no key at all; a key only lifts
# the anonymous per-IP rate limit.
BLOCKSCOUT_API_KEY=
ROUTESCAN_API_KEY=

# Provider order. Leave blank to use the built-in per-chain defaults.
# TRANSACTION_PROVIDERS overrides them for every chain, and a per-chain
# TRANSACTION_PROVIDERS_{CHAIN} overrides both. Known names: etherscan,
# blockscout, routescan, ankr, moralis, covalent, nodereal — anything else is
# dropped with a warning in the log.
TRANSACTION_PROVIDERS=
# TRANSACTION_PROVIDERS_BSC="nodereal,covalent"

# "true" stops the keyless Blockscout/Routescan tail being appended to whatever
# order you set. Only useful when traffic must stay on named providers.
TRANSACTION_PROVIDERS_STRICT=

# Per-attempt timeout in ms (default 12000) and records per request (default
# 1000 — Etherscan's free tier dropped from 10,000 in July 2026). Moralis and
# Ankr cap a page at 100 whatever this says, and NodeReal at 100 (two 50-record
# calls, incoming and outgoing, merged and deduped by hash).
TRANSACTION_PROVIDER_TIMEOUT_MS=
TRANSACTION_PROVIDER_LIMIT=

# Self-hosted or long-tail Blockscout instance for one chain. Beats the built-in
# chainId map, and is the only way to give one of the five chains above with no
# keyless option a keyless provider.
# BSC_BLOCKSCOUT_HOST="blockscout.example.com"

# --------------- RPC FAILOVER ---------------
#
# EVERY CHAIN ACCEPTS MORE THAN ONE ENDPOINT, AND YOU SHOULD GIVE IT MORE THAN
# ONE. Deposits, withdrawals, balance reads and swap broadcasting all run
# through the same provider, so a single rate-limited or briefly-down node
# takes all of them offline at once — and free-tier public endpoints
# rate-limit constantly.
#
# Two ways to configure it, and they compose:
#
#   1. A comma-separated list in the EXISTING key (no new key to learn):
#        ETH_MAINNET_RPC="https://primary.example/v3/KEY, https://backup.example"
#
#   2. A dedicated fallback key, tried after the primary:
#        ETH_MAINNET_RPC="https://primary.example/v3/KEY"
#        ETH_MAINNET_RPC_FALLBACK="https://backup-1.example, https://backup-2.example"
#
# Order is your stated preference; after that the platform picks by measured
# latency. An endpoint that fails three times in a row is taken out of rotation
# with an exponential cooldown (15s, doubling, capped at 5 minutes) and comes
# back on its own — no restart. A single URL still works exactly as before.
#
# Endpoint URLs are redacted in logs and admin screens, because the path
# segment of an Infura or Alchemy URL IS the credential.
# ETH_MAINNET_RPC_FALLBACK=

# --------------- CUSTOM EVM CHAINS ---------------
#
# Custom EVM-compatible chains (e.g. BetaXChain / PBX) are managed entirely from
# the admin dashboard:  Admin > Ecosystem > Custom EVM Chains.
# They are stored in the `ecosystem_custom_chain` table and hydrated into the
# chain registry + process.env at boot — so you do NOT need to add per-chain
# env vars here. The admin UI is the source of truth for these chains.
#
# (Built-in chains still use the SYMBOL_NETWORK / SYMBOL_<NET>_RPC convention, e.g.
#  ETH_NETWORK="mainnet" / ETH_MAINNET_RPC="https://...". A custom chain would map
#  to PBX_NETWORK / PBX_MAINNET_RPC, but those are written automatically from the DB.)
# TransFi API (fiat on/off-ramp — collections, payouts, ramp)
# Credentials from Displai -> Settings -> Integration. Sandbox and production
# credentials are NOT interchangeable: sandbox creds return
# UNAUTHORIZED_CUSTOMER against api.transfi.com and vice versa.
APP_TRANSFI_USERNAME=
APP_TRANSFI_PASSWORD=
APP_TRANSFI_MID=
APP_TRANSFI_WEBHOOK_SECRET=
# Explicit override rather than derived from NODE_ENV, for the reason above.
#   sandbox    -> https://sandbox-api.transfi.com
#   production -> https://api.transfi.com
# NOTE: TransFi's own auth docs print "api-sandbox.transfi.com". That host does
# not resolve (NXDOMAIN) and their documented smoke-test curl cannot run. Do not
# "fix" the value below to match the docs.
APP_TRANSFI_BASE_URL="https://sandbox-api.transfi.com"
# purposeCode sent on every order. Must be one of the 58 values TransFi accepts;
# "other" additionally requires APP_TRANSFI_PURPOSE_REASON (min 10 chars).
APP_TRANSFI_PURPOSE_CODE="personal"
APP_TRANSFI_PURPOSE_REASON=
# Pin the webhook HMAC canonicalization once observed in an environment:
# "raw" (recommended) or "python". Unset = try raw, then fall back and warn.
APP_TRANSFI_SIGNATURE_VARIANT=
# Optional tuning. Sensible defaults apply when blank.
#   SANDBOX               - "false" forces production when BASE_URL is unset
#   TIMEOUT_MS            - per-request timeout (default 30000)
#   CONFIG_CACHE_MS       - currency/method discovery cache (default 600000)
#   SCREENING_POLL_MS     - how long a first deposit waits for TransFi to finish
#                           screening a new payer inside the request (default 6000)
#   SCREENING_RETRY_SECONDS - retry hint handed to the client (default 30)
APP_TRANSFI_SANDBOX=
APP_TRANSFI_TIMEOUT_MS=
APP_TRANSFI_CONFIG_CACHE_MS=
APP_TRANSFI_SCREENING_POLL_MS=
APP_TRANSFI_SCREENING_RETRY_SECONDS=

# --------------- Other fiat deposit gateways ---------------
# These 12 gateways ship enabled-capable but their credentials were declared
# NOWHERE, so a fresh install had no way to discover what to set — the first
# symptom was a 500 on a customer's deposit. Read directly from each gateway's
# utils.ts. All optional: leave blank for any gateway you do not enable in
# Admin -> Finance -> Deposit -> Gateways.

# 2Checkout
APP_2CHECKOUT_MERCHANT_CODE=
APP_2CHECKOUT_SECRET_KEY=
APP_2CHECKOUT_ACCOUNT_REFERENCE=

# Adyen — APP_ADYEN_ENVIRONMENT is "test" or "live"
APP_ADYEN_API_KEY=
APP_ADYEN_CLIENT_KEY=
APP_ADYEN_MERCHANT_ACCOUNT=
APP_ADYEN_HMAC_KEY=
APP_ADYEN_ENVIRONMENT="test"

# Authorize.Net
APP_AUTHORIZENET_API_LOGIN_ID=
APP_AUTHORIZENET_TRANSACTION_KEY=
APP_AUTHORIZENET_SIGNATURE_KEY=

# dLocal — sandbox vs production is chosen by NODE_ENV, not a flag
APP_DLOCAL_X_LOGIN=
APP_DLOCAL_X_TRANS_KEY=
APP_DLOCAL_SECRET_KEY=

# eWAY
APP_EWAY_API_KEY=
APP_EWAY_API_PASSWORD=

# iPay88
APP_IPAY88_MERCHANT_CODE=
APP_IPAY88_MERCHANT_KEY=

# Klarna
APP_KLARNA_USERNAME=
APP_KLARNA_PASSWORD=
APP_KLARNA_WEBHOOK_SECRET=

# Mollie
APP_MOLLIE_API_KEY=
APP_MOLLIE_RETURN_URL=
APP_MOLLIE_WEBHOOK_ENDPOINT=

# PayFast (South Africa)
APP_PAYFAST_MERCHANT_ID=
APP_PAYFAST_MERCHANT_KEY=
APP_PAYFAST_PASSPHRASE=
APP_PAYFAST_SANDBOX="true"
APP_PAYFAST_RETURN_URL=
APP_PAYFAST_CANCEL_URL=
APP_PAYFAST_NOTIFY_URL=

# Paysafe
APP_PAYSAFE_API_KEY=
APP_PAYSAFE_API_SECRET=
APP_PAYSAFE_ACCOUNT_ID=
APP_PAYSAFE_SANDBOX="true"
APP_PAYSAFE_RETURN_URL=
APP_PAYSAFE_WEBHOOK_ENDPOINT=

# Paytm (India)
APP_PAYTM_MID=
APP_PAYTM_MERCHANT_KEY=
APP_PAYTM_WEBSITE=
APP_PAYTM_INDUSTRY_TYPE=
APP_PAYTM_SANDBOX="true"
APP_PAYTM_CALLBACK_URL=
APP_PAYTM_WEBHOOK_ENDPOINT=

# PayU
APP_PAYU_MERCHANT_ID=
APP_PAYU_MERCHANT_KEY=
APP_PAYU_MERCHANT_SALT=
APP_PAYU_SANDBOX="true"
APP_PAYU_SUCCESS_URL=
APP_PAYU_FAILURE_URL=
APP_PAYU_CANCEL_URL=
APP_PAYU_CALLBACK_URL=
APP_PAYU_WEBHOOK_ENDPOINT=

# Public base URL used by several gateways to build return/webhook URLs.
APP_PUBLIC_URL=

# ─── DEX / Swap (Web3 Wallet & On-Chain Trading) ──────────────────────────────
# Vendor API keys. Only the NAME of each variable is stored in the database
# (dexProvider.apiKeyEnvVar); the value is read from the environment at call
# time and is never persisted or serialised by any admin route.
#
# REQUIRED — these two vendors 401 without a key:
APP_DEX_ZEROEX_API_KEY=
APP_DEX_ONEINCH_API_KEY=
#
# OPTIONAL — these quote on open endpoints; a key raises the rate limit.
# TronGrid in particular allows only ~3 requests/second unauthenticated, and a
# single swap-build spends several, so a busy TRON install needs this one.
APP_DEX_JUPITER_API_KEY=
APP_DEX_LIFI_API_KEY=
#
# LI.FI ALSO NEEDS AN INTEGRATOR NAME, and it is not the API key. Register at
# portal.li.fi, configure a fee wallet there, and put the name you registered
# here. LI.FI's integrator namespace is global and the fee wallet is configured
# on THEIR side, so this must be YOUR name — leaving it unset falls back to the
# vendor's, which is registered to somebody else's wallet and will refuse to
# quote for you. While it is wrong or unregistered, LI.FI refuses every quote
# that carries a platform fee (400/code 1011) rather than under-paying.
# ─────────────────────────────────────────────────────────────────────────────
# MARKET NEWS
# ─────────────────────────────────────────────────────────────────────────────
# The provider key for the news feed, held HERE rather than in the mobile app.
#
# It used to ship inside the Flutter binary, in assets/config/app_config.json.
# That is extractable by anyone who downloads the app, the quota is per key and
# the same build goes to every operator, and calling the provider from the
# device disclosed each reader's IP address to a third party. The app now asks
# your backend, and one server-side cache serves every reader from a single
# upstream call.
#
# Free key: https://www.cryptocompare.com/cryptopian/api-keys
# Unset means the news endpoints answer 503 with that link — nothing else
# breaks.
APP_CRYPTOCOMPARE_API_KEY=

APP_DEX_LIFI_INTEGRATOR=
APP_DEX_TRON_API_KEY=
APP_DEX_TON_API_KEY=
#
# KEYLESS: KyberSwap needs nothing at all.
#
# Per-chain RPC overrides, named by the chain's slug in uppercase — e.g.
# APP_DEX_RPC_ETHEREUM, APP_DEX_RPC_BASE, APP_DEX_RPC_SOLANA, APP_DEX_RPC_TRON.
# A chain with none falls back to the ecosystem's network for that chain.
